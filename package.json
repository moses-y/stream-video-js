{
  "name": "@stream-io/video-js-root",
  "description": "Stream Video JS SDKs",
  "author": "https://getstream.io",
  "packageManager": "pnpm@10",
  "private": true,
  "license": "See license in LICENSE",
  "workspaces": [
    "packages/*",
    "sample-apps/*/*"
  ],
  "scripts": {
    "start:react:sdk": "pnpm --filter @stream-io/video-react-sdk run start",
    "build:react:sdk": "pnpm --filter @stream-io/video-react-sdk run build",
    "start:react:bindings": "pnpm --filter @stream-io/video-react-bindings run start",
    "build:react:bindings": "pnpm --filter @stream-io/video-react-bindings run build",
    "build:react:dogfood": "pnpm --filter @stream-io/video-react-dogfood run build",
    "start:react:dogfood": "pnpm --filter @stream-io/video-react-dogfood run dev",
    "start:react-native:sdk": "pnpm --filter @stream-io/video-react-native-sdk run start",
    "build:react-native:sdk": "pnpm --filter @stream-io/video-react-native-sdk run build",
    "test:react-native:sdk": "pnpm --filter @stream-io/video-react-native-sdk run test",
    "test:codemod": "pnpm --filter @stream-io/video-codemod run test",
    "start:react-native:ios:dogfood": "pnpm --filter @stream-io/video-react-native-dogfood run ios",
    "start:react-native:android:dogfood": "pnpm --filter @stream-io/video-react-native-dogfood run android",
    "build:styling": "pnpm --filter @stream-io/video-styling run build",
    "build:react-native-callingx": "pnpm --filter @stream-io/react-native-callingx run build",
    "start:styling": "pnpm --filter @stream-io/video-styling run start",
    "build:client": "pnpm --filter @stream-io/video-client run build",
    "start:client": "pnpm --filter @stream-io/video-client run start",
    "build:audio-filters-web": "pnpm --filter @stream-io/audio-filters-web run build",
    "build:video-filters-web": "pnpm --filter @stream-io/video-filters-web run build",
    "build:video-filters-react-native": "pnpm --filter @stream-io/video-filters-react-native run build",
    "build:noise-cancellation-react-native": "pnpm --filter @stream-io/noise-cancellation-react-native run build",
    "build:react:deps": "yarn workspaces foreach -Apv --topological-dev --include 'packages/{client,react-{sdk,bindings},styling,{video,audio}-filters-web}' run build",
    "build:react-native:deps": "yarn workspaces foreach -Apv --topological-dev --include 'packages/{client,react-bindings,audio-filters-web,{video-filters,noise-cancellation}-react-native,react-native-sdk,react-native-callingx}' run build",
    "build:vercel": "yarn build:react:deps && yarn build:react:dogfood",
    "start:egress": "yarn workspace @stream-io/egress-composite start",
    "build:egress": "yarn workspace @stream-io/egress-composite build",
    "build:all": "yarn workspaces foreach --all -v --topological-dev run build",
    "build:libs": "yarn workspaces foreach --all -v --topological-dev --no-private run build",
    "clean:all": "yarn workspaces foreach --all -vt run clean",
    "lint:all": "yarn lint:packages && yarn lint:sample-apps",
    "lint:packages": "eslint --cache --fix 'packages/**/*.{ts,tsx}' && prettier --check 'packages/**/*.{ts,tsx}'",
    "lint:sample-apps": "eslint --cache --fix 'sample-apps/**/*.{ts,tsx}' && prettier --check 'sample-apps/**/*.{ts,tsx}'",
    "lint:ci:all": "eslint --max-warnings=0 --cache 'packages/**/*.{ts,tsx}' && prettier --check 'packages/**/*.{ts,tsx}'",
    "lint:ci:packages": "eslint --max-warnings=0 --cache 'packages/**/*.{ts,tsx}' && prettier --check 'packages/**/*.{ts,tsx}'",
    "test:ci:all": "yarn workspaces foreach --all -vt run test-ci",
    "test:ci:libs": "yarn workspaces foreach --all -vt --no-private run test-ci",
    "lint:ci:client": "eslint --cache 'packages/client/**/*.{ts,tsx}'",
    "test:ci:client": "pnpm --filter @stream-io/video-client run test-ci",
    "sample:react:messenger": "pnpm --filter @stream-io/messenger-clone-react run dev",
    "sample:react:audio-rooms": "pnpm --filter @stream-io/audio-rooms run dev",
    "sample:react:livestream-app": "pnpm --filter @stream-io/livestream-app run dev",
    "sample:react:zoom-clone": "pnpm --filter @stream-io/zoom-clone-react run dev",
    "sample:react:tutorial": "pnpm --filter @stream-io/stream-video-react-tutorial run dev",
    "release": "nx run-many --target version --parallel=1",
    "release:client": "yarn workspace @stream-io/video-client pnpm publish --access=public --tag=latest",
    "release:codemod": "yarn workspace @stream-io/video-codemod pnpm publish --access=public --tag=latest",
    "release:react-bindings": "yarn workspace @stream-io/video-react-bindings pnpm publish --access=public --tag=latest",
    "release:react-sdk": "yarn workspace @stream-io/video-react-sdk pnpm publish --access=public --tag=latest",
    "release:react-native-sdk": "yarn workspace @stream-io/video-react-native-sdk pnpm publish --access=public --tag=latest",
    "release:react-native-sdk:beta": "node scripts/release-rn-sdk-beta.mjs",
    "release:audio-filters-web": "yarn workspace @stream-io/audio-filters-web pnpm publish --access=public --tag=latest",
    "release:video-filters-web": "yarn workspace @stream-io/video-filters-web pnpm publish --access=public --tag=latest",
    "release:video-filters-react-native": "yarn workspace @stream-io/video-filters-react-native pnpm publish --access=public --tag=latest",
    "release:noise-cancellation-react-native": "yarn workspace @stream-io/noise-cancellation-react-native pnpm publish --access=public --tag=latest",
    "release:react-native-callingx": "yarn workspace @stream-io/react-native-callingx pnpm publish --access=public --tag=latest",
    "release:styling": "yarn workspace @stream-io/video-styling pnpm publish --access=public --tag=latest",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@jscutlery/semver": "^5.7.1",
    "@nx/devkit": "^21.6.4",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "nx": "^21.6.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.7"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "yarn eslint --cache --fix",
    "*.{js,ts,jsx,tsx,md,mdx,scss,css,html,mjs,json}": "yarn prettier --write"
  }
}
